[Unit]
Description=Atelier Inventory ERP sync agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=erpnext
EnvironmentFile=/etc/atelier-erp-sync.env
ExecStart=/usr/bin/python3 /opt/atelier/erp-sync-agent.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
