# ---------------------------------------------------------------------------
# Browser-safe Supabase configuration.
# Both values are public: the anon key is protected by Row Level Security.
# Find them in Supabase → Project settings → API.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server-side only. Used by `npm run seed` and `npm run rls:test`.
# Never prefix these with VITE_, never import them in src/, never commit them.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Seed script only (`npm run seed`).
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ATELIER_NAME=Atelier

# Optional: shared password for the temporary users created by `npm run rls:test`.
# If unset, a random password is generated for each run.
# RLS_TEST_PASSWORD=
