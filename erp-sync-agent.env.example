# /etc/atelier-erp-sync.env
# The credentials for the ERP sync agent.
#
# SUPABASE_SERVICE_ROLE_KEY: Supabase dashboard -> project -> Settings -> API
#   -> service_role (the secret key, not the anon key).
# ERP_API_KEY / ERP_API_SECRET: ERPNext -> your user -> My Settings ->
#   API Access -> Generate Keys.
# ERP_BASE_URL: where ERPNext is, from the point of view of THIS machine.
#   On the ERPNext server itself that is http://localhost:8080.

SUPABASE_URL=https://ofnkpyzmzhxtpwwvrbci.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<paste the service_role key here>
ERP_BASE_URL=http://localhost:8080
ERP_API_KEY=<paste the ERPNext API key here>
ERP_API_SECRET=<paste the ERPNext API secret here>
POLL_INTERVAL=30

# The ERPNext item group for each app category. These are the groups that
# already exist in the atelier's own ERPNext catalogue. Change them here
# if a category should go somewhere else - no code change needed.
ERP_GROUP_WEDDING=Wedding (Bridal)
ERP_GROUP_PARTY=Party (Evening)
ERP_GROUP_ENGAGEMENT=Milka (Engagement)
ERP_GROUP_VEIL=Veil (Tarha)
ERP_GROUP_JUMPSUIT=Dresses
ERP_GROUP_DEFAULT=Dresses
